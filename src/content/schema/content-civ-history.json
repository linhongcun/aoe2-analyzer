{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linhongcun.github.io/aoe2-analyzer/schema/content-civ-history.json",
  "title": "AoE2 civilization history entries",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["summary", "paragraphs", "source", "checkedOn"],
    "additionalProperties": false,
    "properties": {
      "summary": {
        "type": "string",
        "$ref": "common.defs.json#/$defs/sourceText",
        "pattern": "\\S"
      },
      "paragraphs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "string",
          "$ref": "common.defs.json#/$defs/sourceText",
          "pattern": "\\S"
        }
      },
      "source": {
        "type": "object",
        "required": ["label", "url"],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "$ref": "common.defs.json#/$defs/sourceText",
            "pattern": "\\S"
          },
          "url": {
            "$ref": "common.defs.json#/$defs/publicUrl"
          }
        }
      },
      "checkedOn": {
        "type": "string",
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
      }
    }
  },
  "minProperties": 1
}
