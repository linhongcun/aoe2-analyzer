{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linhongcun.github.io/aoe2-analyzer/schema/data-units.json",
  "title": "AoE2 units data",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "form": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/items/properties/id"
          },
          "en": {
            "$ref": "#/items/properties/en"
          },
          "zh": {
            "$ref": "#/items/properties/zh"
          },
          "hp": {
            "$ref": "#/items/properties/hp"
          },
          "atk": {
            "$ref": "#/items/properties/atk"
          },
          "ma": {
            "$ref": "#/items/properties/ma"
          },
          "pa": {
            "$ref": "#/items/properties/pa"
          },
          "rng": {
            "$ref": "#/items/properties/rng"
          },
          "minr": {
            "$ref": "#/items/properties/minr"
          },
          "spd": {
            "$ref": "#/items/properties/spd"
          },
          "los": {
            "$ref": "#/items/properties/los"
          },
          "rof": {
            "$ref": "#/items/properties/rof"
          },
          "acc": {
            "$ref": "#/items/properties/acc"
          },
          "blast": {
            "$ref": "#/items/properties/blast"
          },
          "atks": {
            "$ref": "#/items/properties/atks"
          },
          "arms": {
            "$ref": "#/items/properties/arms"
          },
          "armc": {
            "$ref": "#/items/properties/armc"
          },
          "cls": {
            "$ref": "#/items/properties/cls"
          },
          "attackDelaySeconds": {
            "$ref": "#/items/properties/attackDelaySeconds"
          },
          "frameDelay": {
            "$ref": "#/items/properties/frameDelay"
          },
          "garrisonCapacity": {
            "$ref": "#/items/properties/garrisonCapacity"
          },
          "combatAbility": {
            "$ref": "#/items/properties/combatAbility"
          },
          "kind": {
            "enum": ["weapon", "barrage", "dismount"]
          }
        },
        "required": [
          "id",
          "en",
          "zh",
          "hp",
          "atk",
          "ma",
          "pa",
          "rng",
          "minr",
          "spd",
          "los",
          "rof",
          "acc",
          "blast",
          "atks",
          "arms",
          "armc",
          "cls",
          "combatAbility",
          "kind"
        ],
        "additionalProperties": false
      },
      "id": {
        "type": "integer",
        "minimum": 0
      },
      "en": {
        "$ref": "common.defs.json#/$defs/nonEmptyString"
      },
      "zh": {
        "$ref": "common.defs.json#/$defs/nonEmptyString"
      },
      "type": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "age": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4
      },
      "b": {
        "type": "integer"
      },
      "pic": {
        "type": ["integer", "string"]
      },
      "from_": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "cost": {
        "$ref": "common.defs.json#/$defs/cost"
      },
      "hp": {
        "type": "number"
      },
      "atk": {
        "type": "number"
      },
      "ma": {
        "type": "number"
      },
      "pa": {
        "type": "number"
      },
      "rng": {
        "type": "number"
      },
      "rngBd": {
        "type": "number"
      },
      "minr": {
        "type": "number"
      },
      "spd": {
        "type": "number"
      },
      "los": {
        "type": "number"
      },
      "rof": {
        "type": "number"
      },
      "chargeType": { "type": "integer" },
      "chargeEvent": { "type": "integer" },
      "maxCharge": { "type": "number", "minimum": 0 },
      "rechargeRate": { "type": "number", "minimum": 0 },
      "rechargeDuration": { "type": "number", "minimum": 0 },
      "totalProjectiles": { "type": "integer", "minimum": 2 },
      "chargeMultiProjectiles": { "type": "boolean" },
      "attackDelaySeconds": {
        "type": "number",
        "minimum": 0
      },
      "frameDelay": {
        "type": "integer",
        "minimum": 0
      },
      "tt": {
        "type": "number"
      },
      "trainCount": {
        "type": "integer",
        "minimum": 2
      },
      "acc": {
        "type": "number"
      },
      "displayedReloadTime": { "type": "number" },
      "accuracyDispersion": {
        "type": "number",
        "minimum": 0
      },
      "collisionRadiusX": { "type": "number", "exclusiveMinimum": 0 },
      "collisionRadiusY": { "type": "number", "exclusiveMinimum": 0 },
      "blastDamage": { "type": "number" },
      "blastAttackLevel": { "type": "integer", "minimum": 0 },
      "friendlyFireDamage": { "type": "number", "minimum": 0 },
      "blast": {
        "type": "number"
      },
      "garrisonCapacity": {
        "type": "integer",
        "minimum": 0
      },
      "combatAbility": {
        "type": "integer",
        "minimum": 0
      },
      "projectilePassThrough": { "type": "boolean" },
      "onHitEffect": { "type": "string", "enum": ["dot", "slow", "attack-speed"] },
      "damagedTargetBonus": { "type": "boolean" },
      "lowHpTransform": { "type": "boolean" },
      "deathHealAura": { "type": "boolean" },
      "regenRate": { "type": "number", "exclusiveMinimum": 0 },
      "atks": {
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "arms": {
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "armc": {
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "desc": {
        "type": "string"
      },
      "civs": {
        "type": "array",
        "items": {
          "$ref": "common.defs.json#/$defs/nonEmptyString"
        }
      },
      "cls": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "up": {
        "anyOf": [
          {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "common.defs.json#/$defs/cost"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          {
            "type": "null"
          }
        ]
      },
      "bz": {
        "type": "string"
      },
      "ben": {
        "type": "string"
      },
      "py": {
        "type": "string",
        "pattern": "^[a-z]*$"
      },
      "pyi": {
        "type": "string",
        "pattern": "^[a-z]*$"
      },
      "conversionResistance": {
        "type": "object",
        "properties": {
          "chanceMod": {
            "type": "number"
          },
          "minTimeMod": {
            "type": "number"
          },
          "maxTimeMod": {
            "type": "number"
          }
        },
        "additionalProperties": false
      },
      "bengaliConversion": {
        "type": "object",
        "properties": {
          "minTimeMod": {
            "type": "number"
          },
          "maxTimeMod": {
            "type": "number"
          },
          "bonusDamageReduction": {
            "type": "number"
          }
        },
        "additionalProperties": false,
        "required": ["minTimeMod", "maxTimeMod", "bonusDamageReduction"]
      },
      "casterTasks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "action": {
              "type": "number"
            },
            "value1": {
              "type": "number"
            },
            "value2": {
              "type": "number"
            }
          },
          "additionalProperties": false,
          "required": ["action", "value1", "value2"]
        }
      }
    },
    "dependentRequired": {
      "collisionRadiusX": ["collisionRadiusY"],
      "collisionRadiusY": ["collisionRadiusX"]
    },
    "required": [
      "id",
      "en",
      "zh",
      "type",
      "age",
      "b",
      "pic",
      "from_",
      "cost",
      "hp",
      "atk",
      "ma",
      "pa",
      "rng",
      "minr",
      "spd",
      "los",
      "rof",
      "tt",
      "acc",
      "blast",
      "combatAbility",
      "atks",
      "arms",
      "armc",
      "desc",
      "civs",
      "cls",
      "up",
      "bz",
      "ben",
      "py",
      "pyi"
    ],
    "additionalProperties": false
  },
  "minItems": 1
}
