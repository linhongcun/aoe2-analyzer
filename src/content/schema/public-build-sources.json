{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linhongcun.github.io/aoe2-analyzer/schema/public-build-sources.json",
  "title": "Player-visible build sources",
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "allOf": [
              {
                "$ref": "#/$defs/publicText"
              },
              {
                "$ref": "common.defs.json#/$defs/nonEmptyString"
              }
            ]
          },
          "url": {
            "$ref": "common.defs.json#/$defs/publicUrl"
          },
          "author": {
            "allOf": [
              {
                "$ref": "#/$defs/publicText"
              },
              {
                "$ref": "common.defs.json#/$defs/nonEmptyString"
              }
            ]
          },
          "accessed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": ["title", "url", "author", "accessed"],
        "additionalProperties": false
      }
    },
    "license": {
      "allOf": [
        {
          "$ref": "#/$defs/publicText"
        },
        {
          "$ref": "common.defs.json#/$defs/nonEmptyString"
        }
      ]
    }
  },
  "required": ["sources", "license"],
  "additionalProperties": false,
  "$defs": {
    "publicText": {
      "allOf": [
        {
          "$ref": "common.defs.json#/$defs/sourceText"
        },
        {
          "not": {
            "type": "string",
            "pattern": "\\b(?:[mM][aA][iI][nN]|[mM][aA][sS][tT][eE][rR])\\s+[0-9a-fA-F]{7,40}\\b"
          }
        }
      ]
    }
  }
}
