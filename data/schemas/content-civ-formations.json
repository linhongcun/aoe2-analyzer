{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linhongcun.github.io/aoe2-analyzer/schema/content-civ-formations.json",
  "type": "array",
  "minItems": 37,
  "maxItems": 37,
  "items": {
    "$ref": "#/$defs/civ"
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "discussion", "boundary"],
      "properties": {
        "content": {
          "type": "string",
          "format": "public-url"
        },
        "discussion": {
          "type": "string",
          "format": "public-url"
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["unit", "building", "tech"]
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "age": {
          "enum": [2, 3, 4]
        }
      }
    },
    "trainingCost": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "enum": ["Food", "Wood", "Gold", "Stone"] },
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "historicalName", "role"],
      "dependentSchemas": { "research": { "properties": { "kind": { "const": "unit" } } } },
      "properties": {
        "kind": {
          "enum": ["unit", "building", "tech"]
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "historicalName": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "research": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tech", "effect"],
          "properties": {
            "tech": { "type": "integer", "minimum": 1 },
            "effect": { "type": "string", "minLength": 1 },
            "caveat": { "type": "string", "minLength": 1 },
            "decision": { "$ref": "#/$defs/decisionCopy" },
            "optional": { "const": true },
            "trainingPrice": {
              "type": "object",
              "additionalProperties": false,
              "required": ["before", "after"],
              "properties": {
                "before": { "$ref": "#/$defs/trainingCost" },
                "after": { "$ref": "#/$defs/trainingCost" }
              }
            }
          }
        },
        "age": {
          "enum": [2, 3, 4]
        }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "historicalName", "role"],
      "properties": {
        "kind": {
          "enum": ["unit", "building", "tech"]
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "historicalName": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "age": {
          "enum": [2, 3, 4]
        },
        "condition": {
          "type": "string"
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "preconditions", "entities"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entity"
          }
        }
      }
    },
    "supplement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "entities"],
      "properties": {
        "mode": {
          "enum": [
            "as-needed",
            "choice",
            "replace",
            "progression",
            "mechanism-support",
            "support",
            "conditional",
            "position-variant",
            "mechanism-only",
            "continuation-adjustment",
            "production-alternative",
            "upgrade",
            "conditional-evaluation"
          ]
        },
        "condition": {
          "type": "string"
        },
        "label": { "type": "string", "minLength": 1 },
        "requires": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entityRef" }
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entity"
          }
        }
      }
    },
    "routeDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "const": "route"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z]+(?:-[a-z]+)*$"
        }
      }
    },
    "dependency": {
      "oneOf": [
        {
          "$ref": "#/$defs/entityRef"
        },
        {
          "$ref": "#/$defs/routeDependency"
        }
      ]
    },
    "conditionalBranchCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "text"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conditionBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requires", "title", "context", "decision", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+(?:-[a-z]+)*$"
        },
        "requires": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entityRef"
          }
        },
        "displayRequires": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entityRef"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "partialTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "partialFallback": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "#/$defs/conditionalBranchCopy"
        },
        "decision": {
          "$ref": "#/$defs/conditionalBranchCopy"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenarioGate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "index"],
          "properties": {
            "kind": { "const": "supplement" },
            "index": { "type": "integer", "minimum": 0 },
            "requireFull": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "adjustment" },
            "id": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "conditionBranch" },
            "id": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entityKind", "id"],
          "properties": {
            "kind": { "const": "entity" },
            "entityKind": { "enum": ["unit", "building", "tech"] },
            "id": { "type": "integer", "minimum": 1 },
            "age": { "enum": [2, 3, 4] }
          }
        }
      ]
    },
    "scenarioOmitSupplementCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supplementIndex", "coveredBy"],
      "properties": {
        "supplementIndex": { "type": "integer", "minimum": 0 },
        "coveredBy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["adjustment", "conditionBranch"] },
            "id": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" }
          }
        }
      }
    },
    "scenarioCaveat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "whenAvailable": { "$ref": "#/$defs/scenarioGate" }
      }
    },
    "scenarioLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "whenAvailable": { "$ref": "#/$defs/scenarioGate" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chipLabel"],
      "anyOf": [
        { "properties": { "supplementIndices": {} }, "required": ["supplementIndices"] },
        { "properties": { "adjustmentIds": {} }, "required": ["adjustmentIds"] },
        { "properties": { "conditionBranchIds": {} }, "required": ["conditionBranchIds"] }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "chipLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "actionHint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "actionHintGate": {
          "$ref": "#/$defs/scenarioGate"
        },
        "group": {
          "enum": ["opponent", "condition"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "summaryGate": {
          "$ref": "#/$defs/scenarioGate"
        },
        "omitSupplementConditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scenarioOmitSupplementCondition" }
        },
        "caveats": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scenarioCaveat" }
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scenarioLink" }
        },
        "supplementIndices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "adjustmentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" }
        },
        "conditionBranchIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" }
        }
      }
    },
    "decisionCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exception"],
      "properties": {
        "condition": { "type": "string", "minLength": 1 },
        "also": { "type": "string", "minLength": 1 },
        "exception": { "type": "string", "minLength": 1 }
      }
    },
    "adjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+(?:-[a-z]+)*$"
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "decision": { "$ref": "#/$defs/decisionCopy" },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "fallback": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recognition", "playtest", "scope", "recordedVersion", "sourceLines"],
      "properties": {
        "recognition": {
          "type": "string",
          "minLength": 1
        },
        "playtest": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "recordedVersion": {
          "type": "string",
          "minLength": 1
        },
        "sourceLines": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "href"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "href": { "type": "string", "format": "public-url" },
              "requires": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/entityRef" }
              }
            }
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "playtest",
        "composition",
        "age",
        "patch",
        "revised",
        "condition",
        "required",
        "prerequisites",
        "supplements",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+(?:-[a-z]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "tabHint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "status": {
          "enum": ["approved", "candidate", "unverified", "draft"]
        },
        "playtest": {
          "enum": ["reported", "pending", "unreported"]
        },
        "composition": {
          "enum": ["combined", "choice", "progression"]
        },
        "presentation": { "enum": ["age-progression", "separate-support"] },
        "age": {
          "enum": [2, 3, 4]
        },
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["build", "date"],
          "properties": {
            "build": {
              "type": "integer",
              "minimum": 1
            },
            "date": {
              "type": "string",
              "format": "iso-date"
            }
          }
        },
        "revised": {
          "type": "string",
          "format": "iso-date"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "choiceLabel": { "type": "string", "minLength": 1 },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prerequisite"
          }
        },
        "supplements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supplement"
          }
        },
        "conditionBranches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/conditionBranch" }
        },
        "adjustments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adjustment"
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "reason": {
          "type": "string"
        },
        "limitation": {
          "type": "string"
        },
        "attack": {
          "type": "string"
        },
        "defense": {
          "type": "string"
        },
        "alternatives": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "composition": {
                "const": "choice"
              }
            },
            "required": ["composition"]
          },
          "then": {
            "required": ["choices"],
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": { "presentation": { "const": "age-progression" } },
            "required": ["presentation"]
          },
          "then": {
            "properties": {
              "composition": { "const": "progression" },
              "choices": { "type": "array", "maxItems": 0 },
              "prerequisites": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ]
    },
    "civ": {
      "type": "object",
      "additionalProperties": false,
      "required": ["civ", "lead", "source", "routes"],
      "properties": {
        "civ": {
          "type": "string",
          "pattern": "^[A-Za-z]+$"
        },
        "lead": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "routeGroups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "note", "routes"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "note": { "type": "string", "minLength": 1 },
              "routes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "label": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
