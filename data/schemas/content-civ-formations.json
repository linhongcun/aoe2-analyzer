{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linhongcun.github.io/aoe2-analyzer/schema/content-civ-formations.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["civ", "lead", "source", "routes"],
    "properties": {
      "civ": {
        "type": "string",
        "pattern": "^[A-Za-z]+$"
      },
      "lead": {
        "type": "string",
        "minLength": 1
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content", "discussion", "boundary"],
        "properties": {
          "content": {
            "type": "string",
            "format": "public-url"
          },
          "discussion": {
            "type": "string",
            "format": "public-url"
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "routes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/route"
        }
      }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "historicalName", "role"],
      "properties": {
        "kind": {
          "enum": ["unit", "building", "tech"]
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "historicalName": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "playtest",
        "patch",
        "revised",
        "condition",
        "required",
        "supplements",
        "reason",
        "limitation",
        "attack",
        "defense",
        "adjustments",
        "alternatives",
        "prerequisites"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+(?:-[a-z]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["approved", "draft"]
        },
        "playtest": {
          "const": "unreported"
        },
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["build", "date"],
          "properties": {
            "build": {
              "type": "integer",
              "minimum": 1
            },
            "date": {
              "type": "string",
              "format": "iso-date"
            }
          }
        },
        "revised": {
          "type": "string",
          "format": "iso-date"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "supplements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        },
        "attack": {
          "type": "string",
          "minLength": 1
        },
        "defense": {
          "type": "string",
          "minLength": 1
        },
        "adjustments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "when", "text"],
            "properties": {
              "when": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "requires": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/dependency"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z]+(?:-[a-z]+)*$"
              },
              "fallback": {
                "type": "string",
                "minLength": 1
              }
            },
            "dependentRequired": {
              "fallback": ["requires"]
            }
          }
        },
        "alternatives": {
          "type": "string",
          "minLength": 1
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "uniqueItems": true
        }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["unit", "building", "tech"]
        },
        "id": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "dependency": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": {
              "const": "route"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z]+(?:-[a-z]+)*$"
            }
          }
        }
      ]
    }
  }
}
