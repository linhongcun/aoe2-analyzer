{
  "name": "aoe2-analyzer",
  "private": true,
  "license": "MIT",
  "version": "0.32.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/page_metadata.mjs && tsc -p . && vite build && node scripts/static_pages.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint . && npm run lint:colors && npm run lint:css",
    "lint:css": "node scripts/check-css.mjs",
    "lint:colors": "node scripts/check-colors.mjs",
    "lint:layers": "node scripts/check-layers.mjs",
    "format": "prettier --write .",
    "data": "python3 scripts/build_data.py && node scripts/pinyin_build.mjs",
    "introductions": "node scripts/catalog_introductions.mjs",
    "introductions:check": "node scripts/catalog_introductions.mjs --check",
    "pinyin:check": "node scripts/pinyin_build.mjs --check",
    "dat:check": "python3 scripts/dat_source.py --check",
    "effects": "python3 scripts/effects_build.py && vite-node scripts/effects_audit.ts",
    "stats:check": "python3 scripts/stats_crosscheck.py",
    "data:update": "python3 scripts/data_update.py",
    "data:status": "python3 scripts/data_update.py --check",
    "test:py": "python3 -m unittest discover -s tests/py -v",
    "bo:check": "vite-node scripts/build_orders_check.ts",
    "eco": "python3 scripts/eco_build.py",
    "sim": "vite-node scripts/sim_try.ts",
    "release": "node scripts/release.mjs",
    "patches": "python3 scripts/patches_build.py",
    "metadata:check": "node scripts/page_metadata.mjs --check"
  },
  "dependencies": {
    "lucide-react": "^1.54.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pinyin-pro": "3.29.5",
    "postcss": "^8.5.30",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
