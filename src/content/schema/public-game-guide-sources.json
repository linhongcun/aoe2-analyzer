{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linhongcun.github.io/aoe2-analyzer/schema/public-game-guide-sources.json",
  "title": "Player-visible game-guide sources",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "allOf": [
      {
        "$ref": "content-game-guide.json#/$defs/source"
      },
      {
        "type": "object",
        "properties": {
          "title": {
            "$ref": "#/$defs/publicText"
          },
          "kind": {
            "$ref": "#/$defs/publicText"
          },
          "version": {
            "$ref": "#/$defs/publicText"
          },
          "locator": {
            "$ref": "#/$defs/publicText"
          },
          "note": {
            "$ref": "#/$defs/publicText"
          }
        }
      }
    ]
  },
  "$defs": {
    "publicText": {
      "allOf": [
        {
          "$ref": "common.defs.json#/$defs/sourceText"
        },
        {
          "not": {
            "type": "string",
            "pattern": "\\b(?:[mM][aA][iI][nN]|[mM][aA][sS][tT][eE][rR])\\s+[0-9a-fA-F]{7,40}\\b"
          }
        }
      ]
    }
  }
}
