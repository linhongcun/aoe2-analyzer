{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linhongcun.github.io/aoe2-analyzer/schema/data-ladder-4v4.json",
  "title": "AoE2 ladder civ stats snapshot (4v4 random map)",
  "type": "object",
  "required": ["source", "sourceUrl", "map", "mode", "fetchedAt", "patchNote", "period", "elo", "sample", "brackets"],
  "additionalProperties": false,
  "properties": {
    "source": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string", "pattern": "^https?://" },
    "map": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "fetchedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "patchNote": { "type": "string", "minLength": 1 },
    "period": {
      "type": "object",
      "required": ["key", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "to": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "elo": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer" },
        "max": { "type": "integer" }
      }
    },
    "sample": {
      "type": "object",
      "required": ["unit", "note"],
      "additionalProperties": false,
      "properties": {
        "unit": { "enum": ["player"] },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "lowSampleGames": { "type": "integer", "minimum": 0 },
    "brackets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "label", "games", "civs"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "games": { "type": "integer", "minimum": 0 },
          "civs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["en", "winRate", "playRate", "games"],
              "additionalProperties": false,
              "properties": {
                "en": { "type": "string", "minLength": 1 },
                "winRate": { "type": "number", "minimum": 0, "maximum": 100 },
                "playRate": { "type": "number", "minimum": 0, "maximum": 100 },
                "games": { "type": "integer", "minimum": 0 },
                "wins": { "type": "integer", "minimum": 0 },
                "ci95Low": { "type": "number", "minimum": 0, "maximum": 100 },
                "ci95High": { "type": "number", "minimum": 0, "maximum": 100 },
                "trend": {
                  "description": "Old-to-new points inside this same slice. Omit when the source series is a different window.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["period", "winRate"],
                    "additionalProperties": false,
                    "properties": {
                      "period": { "type": "string", "minLength": 1 },
                      "winRate": { "type": "number", "minimum": 0, "maximum": 100 },
                      "games": { "type": "integer", "minimum": 0 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
